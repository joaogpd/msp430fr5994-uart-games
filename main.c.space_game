#include <msp430.h>
#include <stdint.h>
#include <stdbool.h>
#include <stddef.h>

#include "drivers/board/board.h"
#include "drivers/msp430/cs.h"
#include "drivers/msp430/uart.h"
#include "drivers/msp430/timer.h"
#include "drivers/msp430/hal_common.h"
#include "app/space_game.h"

/* 1024-byte TX ring buffer fits an entire ANSI terminal frame in one call */
static uint8_t s_uart_tx_buf[1024];
static volatile bool s_tick_due = false;

static bool on_uart_rx(uart_id_t id, uint8_t byte, bool error)
{
    (void)id;
    if (error)
    {
        return false;
    }
    return space_game_push_input(byte);
}

static bool on_game_timer(timer_id_t id)
{
    (void)id;
    s_tick_due = true;
    return true; /* Wake main() from LPM */
}

int main(void)
{
    /* 1. Safe pin & watchdog bring-up (also clears LOCKLPM5) */
    board_init(NULL);

    /* 2. Configure 8 MHz DCO (MCLK/SMCLK) and 32.768 kHz LFXT (ACLK) */
    cs_config_t cs_cfg = CS_CONFIG_DEFAULT;
    (void)cs_init(&cs_cfg);

    /* 3. Route P2.0/P2.1 to eUSCI_A0 and initialize interrupt-driven UART */
    board_uart_pins(true);
    uart_config_t uart_cfg = {
        .baud    = 115200u,
        .clk     = UART_CLK_SMCLK,
        .tx_buf  = s_uart_tx_buf,
        .tx_size = (uint16_t)sizeof(s_uart_tx_buf),
        .rx_cb   = on_uart_rx
    };
    (void)uart_init(UART_A0, &uart_cfg);

    /* 4. Initialize game state (auto-resumes FRAM checkpoint if S1 is held on boot) */
    space_game_init();

    /* 5. Start 20 ms (50 Hz) ACLK periodic timer for responsive input & physics */
    (void)timer_start_periodic_ms(TIMER_A0, 20u, on_game_timer);

    __bis_SR_register(GIE);

    while (1)
    {
        uint16_t sr = hal_enter_critical();
        bool run_tick = s_tick_due;
        s_tick_due = false;
        hal_exit_critical(sr);

        if (run_tick)
        {
            space_game_tick();
            space_game_render();
        }

        /* Sleep until next 20 ms timer tick or UART RX byte */
        __bis_SR_register(LPM0_bits | GIE);
    }
}
